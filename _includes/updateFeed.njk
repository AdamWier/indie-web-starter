{% import "shared/updateFeedItem.njk" as feedItemTemplate %}

<div class="card shadow-lg my-3 w-100">
    <div class="card-header bg-primary text-white">
            My latest updates
    </div>
    <div class="card-body p-0">
        <ul class="list-group h-feed overflow-y-scroll" style="max-height: 92vh; min-height: 0 px">
            {%for post in collections.allUpdates | limit(30) %}
                {{ feedItemTemplate.updateFeedItem(post.date, post.content, post.url, false, post.data.photo, post.data["in-reply-to"], post.data["like-of"], post.data["syndication"], collections.webmentionsByPost, post.video)}}
            {% endfor %}
        </ul>
    </div>
</div>
